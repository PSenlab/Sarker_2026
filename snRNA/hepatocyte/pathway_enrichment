#!/usr/bin/env python3
# ==============================================================================
# Reactome Enrichment of Pseudobulk DESeq2 K-Means Clusters (Dual Model)
# ==============================================================================
#
# Description:
#   Companion to pseudobulk_deseq2_dual_model.R. For each DESeq2 model
#   (with_sex and without_sex) and each k-means cluster of age-significant
#   genes, converts mouse genes to human orthologs via mygene and runs
#   Enrichr Reactome_Pathways_2024 enrichment with a hepatocyte-expressed
#   background. Produces per-model bubble plots of top pathways across
#   clusters, and Venn diagrams comparing cluster-to-cluster pathway
#   overlap between the two models.
#
# Input:
#   - rna_wnn.h5ad  (canonical AnnData, for hepatocyte background)
#   - deseq2_<celltype>/<model>/genes_cluster_<k>.csv
#         produced by pseudobulk_deseq2_dual_model.R STEP 3
#
# Output:
#   deseq2_<celltype>/
#     <model>/enrichr_reactome/
#       Cluster_<k>_Reactome_2024_results.csv
#       Reactome_Top<N>_allClusters.csv
#       Reactome_Top<N>_allClusters_bubble.pdf
#     pathway_overlap_top<N>_<label>.csv         (one per Venn comparison)
#     pathway_venn_top<N>_<label>.png
#
#
# ==============================================================================

import os
import warnings
import numpy as np
import pandas as pd
import scanpy as sc
import matplotlib.pyplot as plt
import matplotlib as mpl
import seaborn as sns
import gseapy as gp
import mygene
from matplotlib.patches import Circle

warnings.filterwarnings("ignore")

# Global plot settings
mpl.rcParams["font.family"] = "Arial"
mpl.rcParams["pdf.fonttype"] = 42
mpl.rcParams["ps.fonttype"] = 42


# ==============================================================================
# CONFIGURATION - UPDATE PATHS AS NEEDED
# ==============================================================================

ADATA_PATH    = "rna_wnn.h5ad"
TARGET_CELLTYPE = "Hepatocyte"

# Base directory produced by pseudobulk_deseq2_dual_model.R
BASE_ROOT     = f"deseq2_{TARGET_CELLTYPE.lower()}"

MODELS        = ["model_with_sex", "model_without_sex"]
N_CLUSTERS    = 4
TOP_N         = 20
GENE_SET      = "Reactome_Pathways_2024"

# Background filter
EXPRESSION_THRESHOLD = 0.05

# Enrichment filters (for the bubble plot's "top per cluster" step)
PVAL_THRESHOLD = 0.05
MIN_GENES      = 3

# Colors (per-cluster) for the bubble plot
CLUSTER_COLORS = {
    "Cluster1": "lightpink",
    "Cluster2": "#FFEDA0",
    "Cluster3": "darkred",
    "Cluster4": "#66C2A5",
}

# Cross-model cluster comparisons to Venn-plot.
# Each tuple is (without_sex_cluster, with_sex_cluster, label_slug).
# Update or extend this list as the cluster semantics of your run dictate.
VENN_COMPARISONS = [
    ("Cluster4", "Cluster4", "withoutC4_vs_withC4"),
    ("Cluster2", "Cluster3", "withoutC2_vs_withC3"),
    ("Cluster3", "Cluster1", "withoutC3_vs_withC1"),
    ("Cluster4", "Cluster2", "withoutC4_vs_withC2"),
]


# ==============================================================================
# HELPERS
# ==============================================================================

def banner(text):
    line = "=" * 70
    print()
    print(line)
    print(text)
    print(line)


def convert_mouse_to_human(mouse_genes):
    """Convert mouse gene symbols to human orthologs via HomoloGene."""
    mouse_genes = sorted({g for g in mouse_genes if pd.notna(g) and g})
    if not mouse_genes:
        return []

    mg = mygene.MyGeneInfo()
    gene_conversion = mg.querymany(
        mouse_genes, scopes="symbol", fields="homologene",
        species="mouse", as_dataframe=False, verbose=False,
    )

    human_entrez_ids = set()
    for entry in gene_conversion:
        if isinstance(entry, dict) and "homologene" in entry:
            for tax_id, entrez_id in entry["homologene"].get("genes", []):
                if tax_id == 9606:
                    human_entrez_ids.add(entrez_id)

    if not human_entrez_ids:
        return []

    human_conversion = mg.querymany(
        list(human_entrez_ids), scopes="entrezgene", fields="symbol",
        species="human", as_dataframe=False, verbose=False,
    )
    return sorted({
        entry["symbol"].upper()
        for entry in human_conversion
        if isinstance(entry, dict) and "symbol" in entry
    })


def run_enrichr(gene_list, background, gene_set, outfile_prefix, min_genes=3):
    """Run Enrichr with explicit background; filter and save results."""
    if len(gene_list) < 3:
        print(f"  [SKIP] Too few genes ({len(gene_list)}) for "
              f"{os.path.basename(outfile_prefix)}")
        return pd.DataFrame()

    try:
        enr = gp.enrichr(
            gene_list=gene_list,
            gene_sets=gene_set,
            organism="Human",
            background=background,
            outdir=None,
            no_plot=True,
        )
    except Exception as e:
        print(f"  [ERROR] Enrichr failed for "
              f"{os.path.basename(outfile_prefix)}: {e}")
        return pd.DataFrame()

    if enr is None or not hasattr(enr, "results"):
        return pd.DataFrame()

    df = pd.DataFrame(enr.results)
    if df.empty:
        print(f"  [SKIP] No enrichment terms for "
              f"{os.path.basename(outfile_prefix)}")
        return pd.DataFrame()

    input_set = {g.upper() for g in gene_list}

    def recount_overlap(gene_str):
        if not isinstance(gene_str, str) or gene_str.strip() == "":
            return 0
        genes = {g.strip().upper() for g in gene_str.split(";") if g.strip()}
        return len(genes & input_set)

    df["Gene Count"] = df["Genes"].apply(recount_overlap)
    df["-log10(p-value)"] = -np.log10(df["P-value"].clip(lower=1e-300))
    df = df[
        (df["P-value"] < PVAL_THRESHOLD)
        & (df["Gene Count"] >= min_genes)
    ].copy()

    df.to_csv(f"{outfile_prefix}_results.csv", index=False)
    print(f"  [OK] {os.path.basename(outfile_prefix)}: {len(df)} terms")
    return df


def run_model(model_name, background):
    """Run per-cluster enrichment and the cross-cluster bubble plot for one model."""
    banner(f"MODEL: {model_name}")

    base_dir = os.path.join(BASE_ROOT, model_name)
    out_dir  = os.path.join(base_dir, "enrichr_reactome")
    os.makedirs(out_dir, exist_ok=True)

    # Per-cluster enrichment
    for cluster in range(1, N_CLUSTERS + 1):
        infile = os.path.join(base_dir, f"genes_cluster_{cluster}.csv")
        if not os.path.exists(infile):
            print(f"  [SKIP] Missing: {infile}")
            continue

        mouse_genes = pd.read_csv(infile)["Gene"].dropna().astype(str).tolist()
        human_genes = convert_mouse_to_human(mouse_genes)
        print(f"  Cluster {cluster}: {len(mouse_genes)} mouse -> "
              f"{len(human_genes)} human genes")

        run_enrichr(
            human_genes, background,
            gene_set=GENE_SET,
            outfile_prefix=os.path.join(out_dir, f"Cluster_{cluster}_Reactome_2024"),
            min_genes=MIN_GENES,
        )

    # Combine per-cluster results
    all_clusters = []
    for cluster in range(1, N_CLUSTERS + 1):
        fname = os.path.join(out_dir, f"Cluster_{cluster}_Reactome_2024_results.csv")
        if os.path.exists(fname):
            df = pd.read_csv(fname)
            df["Cluster"] = f"Cluster{cluster}"
            all_clusters.append(df)

    if not all_clusters:
        print(f"  [SKIP] No per-cluster results for {model_name} - no bubble plot")
        return

    combined_df = pd.concat(all_clusters, ignore_index=True)
    combined_df = combined_df[combined_df["P-value"] < PVAL_THRESHOLD].copy()

    # Top N per cluster, sorted by Gene Count
    top_list = []
    for cluster in combined_df["Cluster"].unique():
        temp = combined_df[combined_df["Cluster"] == cluster]
        temp_sorted = temp.sort_values("Gene Count", ascending=False).head(TOP_N)
        top_list.append(temp_sorted)
    top_df = pd.concat(top_list, ignore_index=True)

    top_df = top_df.sort_values("Odds Ratio", ascending=True)
    top_df["Term"] = pd.Categorical(
        top_df["Term"], categories=top_df["Term"].unique(), ordered=True,
    )

    top_df.to_csv(
        os.path.join(out_dir, f"Reactome_Top{TOP_N}_allClusters.csv"),
        index=False,
    )

    # Bubble plot
    fig_height = max(10, 0.35 * len(top_df))
    plt.figure(figsize=(16, fig_height))
    ax = plt.gca()

    ax.hlines(
        y=top_df["Term"], xmin=0, xmax=top_df["Odds Ratio"],
        color="gray", linestyle="dotted", linewidth=1,
    )

    sns.scatterplot(
        data=top_df,
        x="Odds Ratio", y="Term",
        size="Gene Count", hue="Cluster",
        palette=CLUSTER_COLORS,
        sizes=(80, 400),
        edgecolor="black", linewidth=0.8, alpha=0.95,
    )

    ax.set_xlabel("Odds Ratio", fontsize=14, weight="bold")
    ax.set_ylabel(f"Reactome pathways (top {TOP_N} per cluster)",
                  fontsize=14, weight="bold")
    ax.set_title(
        f"Reactome pathways - top {TOP_N} per cluster ({model_name})\n"
        f"P < {PVAL_THRESHOLD}, sorted by odds ratio",
        fontsize=16, weight="bold",
    )

    handles, labels = ax.get_legend_handles_labels()
    ax.legend(
        handles, labels,
        bbox_to_anchor=(1.32, 1), loc="upper left", title="Cluster",
    )

    plt.tight_layout()
    out_pdf = os.path.join(out_dir, f"Reactome_Top{TOP_N}_allClusters_bubble.pdf")
    plt.savefig(out_pdf, bbox_inches="tight", dpi=300)
    plt.close()
    print(f"  [OK] {out_pdf}")


def plot_venn(without_label, with_label, without_set, with_set, out_png):
    """Two-set Venn diagram (simple mpl circles)."""
    shared       = without_set & with_set
    only_without = without_set - with_set
    only_with    = with_set - without_set

    fig, ax = plt.subplots(figsize=(8, 6))
    ax.add_patch(Circle((-0.5, 0), 1.2, alpha=0.5, color="#E74C3C"))
    ax.add_patch(Circle(( 0.5, 0), 1.2, alpha=0.5, color="#3498DB"))

    ax.text(-1.1, 0, str(len(only_without)),
            fontsize=18, ha="center", va="center", fontweight="bold")
    ax.text( 1.1, 0, str(len(only_with)),
            fontsize=18, ha="center", va="center", fontweight="bold")
    ax.text( 0.0, 0, str(len(shared)),
            fontsize=18, ha="center", va="center", fontweight="bold")

    ax.text(-1.1, 1.4, without_label,
            fontsize=13, ha="center", fontweight="bold", color="#A93226")
    ax.text( 1.1, 1.4, with_label,
            fontsize=13, ha="center", fontweight="bold", color="#2471A3")

    ax.set_xlim(-2.5, 2.5)
    ax.set_ylim(-1.8, 2.0)
    ax.set_aspect("equal")
    ax.axis("off")
    ax.set_title(
        f"Top {TOP_N} Reactome pathways\n{without_label} vs {with_label}",
        fontsize=13, fontweight="bold",
    )

    plt.tight_layout()
    plt.savefig(out_png, bbox_inches="tight", dpi=300)
    plt.close()


# ==============================================================================
# 1. BUILD BACKGROUND FROM HEPATOCYTE-EXPRESSED GENES
# ==============================================================================

banner("STEP 1: Build hepatocyte-expressed background gene set")

print(f"  Loading {ADATA_PATH}")
adata = sc.read_h5ad(ADATA_PATH)
adata = adata[adata.obs["celltype"] == TARGET_CELLTYPE].copy()
print(f"  {TARGET_CELLTYPE} cells: {adata.n_obs:,}")

avg_expr = np.asarray(adata.X.mean(axis=0)).flatten()
expressed_genes = adata.var_names[avg_expr > EXPRESSION_THRESHOLD].tolist()
expressed_genes = [g.upper() for g in expressed_genes if isinstance(g, str)]
print(f"  Background genes (mean expr > {EXPRESSION_THRESHOLD}): "
      f"{len(expressed_genes):,}")


# ==============================================================================
# 2. PER-CLUSTER REACTOME ENRICHMENT FOR EACH MODEL
# ==============================================================================

for model in MODELS:
    run_model(model, background=expressed_genes)


# ==============================================================================
# 3. CROSS-MODEL VENN COMPARISONS
# ==============================================================================

banner("STEP 3: Cross-model cluster-to-cluster pathway Venn diagrams")

def load_top_table(model):
    path = os.path.join(
        BASE_ROOT, model, "enrichr_reactome",
        f"Reactome_Top{TOP_N}_allClusters.csv",
    )
    return pd.read_csv(path) if os.path.exists(path) else None

without_top = load_top_table("model_without_sex")
with_top    = load_top_table("model_with_sex")

if without_top is None or with_top is None:
    print("  [SKIP] Missing Top-N table for one or both models")
else:
    for without_cluster, with_cluster, label in VENN_COMPARISONS:

        print(f"\n  {label}: without_sex {without_cluster} "
              f"vs with_sex {with_cluster}")

        without_terms = set(
            without_top.loc[without_top["Cluster"] == without_cluster, "Term"]
        )
        with_terms = set(
            with_top.loc[with_top["Cluster"] == with_cluster, "Term"]
        )

        shared       = without_terms & with_terms
        only_without = without_terms - with_terms
        only_with    = with_terms - without_terms

        print(f"    without_sex {without_cluster}: {len(without_terms)} pathways")
        print(f"    with_sex    {with_cluster}:    {len(with_terms)} pathways")
        print(f"    Shared:              {len(shared)}")
        print(f"    Only without_sex:    {len(only_without)}")
        print(f"    Only with_sex:       {len(only_with)}")

        # Save overlap table
        overlap_df = pd.DataFrame({
            "Term": list(shared) + list(only_without) + list(only_with),
            "Category": (
                ["Shared"] * len(shared)
                + [f"Only_without_sex_{without_cluster}"] * len(only_without)
                + [f"Only_with_sex_{with_cluster}"] * len(only_with)
            ),
        })
        overlap_csv = os.path.join(
            BASE_ROOT, f"pathway_overlap_top{TOP_N}_{label}.csv"
        )
        overlap_df.to_csv(overlap_csv, index=False)

        # Venn
        venn_png = os.path.join(
            BASE_ROOT, f"pathway_venn_top{TOP_N}_{label}.png"
        )
        plot_venn(
            without_label=f"without_sex_{without_cluster}",
            with_label=f"with_sex_{with_cluster}",
            without_set=without_terms,
            with_set=with_terms,
            out_png=venn_png,
        )

        print(f"    [OK] {overlap_csv}")
        print(f"    [OK] {venn_png}")

        if shared:
            print(f"    Shared pathways:")
            for t in sorted(shared):
                print(f"      - {t}")


# ==============================================================================
# DONE
# ==============================================================================
banner("ALL DONE")
for model in MODELS:
    print(f"  {BASE_ROOT}/{model}/enrichr_reactome/")
print(f"  {BASE_ROOT}/pathway_overlap_top{TOP_N}_*.csv")
print(f"  {BASE_ROOT}/pathway_venn_top{TOP_N}_*.png")
